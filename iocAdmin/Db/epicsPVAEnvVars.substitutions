    { PVA_SRVR_PORT              , EPICS_PVA_SERVER_PORT            , env  }

    { PVAS_ADDR_INTF_LIST        , EPICS_PVAS_INTF_ADDR_LIST        , env  }
    { PVAS_ADDR_LIST             , EPICS_PVAS_BEACON_ADDR_LIST      , env  }
    { PVAS_AUTO_ADDR             , EPICS_PVAS_AUTO_BEACON_ADDR_LIST , env  }
